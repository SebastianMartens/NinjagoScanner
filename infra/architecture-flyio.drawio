                <mxCell id="e12" value="flyctl deploy&#xa;(3 apps, path-filtered, push to main)" style="html=1;fontSize=11;endArrow=block;strokeColor=#666666;" parent="1" source="n_github" target="box_fly" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n_note" value="Removed vs. current AWS plan: VPC, NAT Gateway, internal NLB, ECS/Fargate, Service Connect, Lambda BFF, API Gateway, CloudFront, S3 static-site bucket, Secrets Manager, ECR, GitHub OIDC roles, all Terraform for the above.&#xa;Kept: S3 photos bucket, DynamoDB sidecar table + GSIs, presigned-URL upload flow, gRPC contracts between the 3 services, CatalogService/PictureService code unchanged.&#xa;Changed: ECS task-role → IAM user access keys (as Fly secrets); Service Connect/internal NLB → Fly 6PN private networking; Secrets Manager → Fly Secrets.&#xa;Open design choice sketched here: Web.Client (WASM) + Web.Bff recombined into one Fly app, since Fly runs always-on machines (not Lambda) — the split existed only to satisfy Lambda&#39;s stateless constraint." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8DC;strokeColor=#B8860B;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="260" y="740" width="1160" height="140" as="geometry"/>
                </mxCell>
