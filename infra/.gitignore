# Terraform local state/working files — never commit these; remote state
# lives in S3 (see README.md).
**/.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Account-specific values, filled in locally from bootstrap's output.
*.tfvars
!*.tfvars.example
backend.hcl
!backend.hcl.example

# Note: .terraform.lock.hcl is intentionally NOT ignored — it pins provider
# versions and should be committed once `terraform init` generates it.

# Generated by modules/bff-lambda's archive_file data source (a placeholder
# Lambda deployment package for the first `terraform apply` — see that
# module's header comment). Never a real deployable artifact, never commit.
.placeholder.zip

# Saved plan files and ad-hoc plan/apply logs — transient, regenerate as needed.
tfplan
plan-*.txt
apply-output*.txt
