<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="NinjagoScanner_Desktop.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:NinjagoScanner_Desktop"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="OnPageLoaded"
    Unloaded="OnPageUnloaded">

    <Grid Background="#101418">
        <WebView2 x:Name="BrowserView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <Border
            x:Name="LoadingOverlay"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Padding="24"
            Background="#CC1B232B"
            CornerRadius="18">
            <StackPanel Spacing="12" HorizontalAlignment="Center" MaxWidth="760">
                <ProgressRing x:Name="LoadingProgressRing" IsActive="True" Width="42" Height="42" HorizontalAlignment="Center" />
                <TextBlock
                    x:Name="StatusTextBlock"
                    HorizontalAlignment="Center"
                    Foreground="White"
                    FontSize="16"
                    TextWrapping="WrapWholeWords"
                    Text="Starte Web-Anwendung..." />
            </StackPanel>
        </Border>
    </Grid>
</Page>
