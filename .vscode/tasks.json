{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/NinjagoScanner.slnx",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign",
                "-maxcpucount:1" // fix race condition in Nuget restore
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/NinjagoScanner.Web/NinjagoScanner.Web.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/NinjagoScanner.Web/NinjagoScanner.Web.csproj"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            // Uses the venv's own python.exe directly (not "uv run") since `uv` itself isn't
            // guaranteed to be on PATH (it was pip-installed into a Python user site here, not a
            // PATH-visible location) - the venv interpreter needs no PATH lookup at all.
            "label": "picture-service: gen-proto",
            "command": "${workspaceFolder}/picture_service/.venv/Scripts/python.exe",
            "type": "process",
            "args": [
                "scripts/gen_proto.py"
            ],
            "options": {
                "cwd": "${workspaceFolder}/picture_service"
            },
            "problemMatcher": []
        }
    ]
}
