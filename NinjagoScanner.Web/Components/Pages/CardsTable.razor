@page "/table"
@inject CardCatalogService CardCatalogService

<PageTitle>Karten Tabelle</PageTitle>

<div class="table-page">
	<header class="table-header">
		<div>
			<p class="eyebrow">Ninjago Scanner</p>
			<h1>Tabellarische Kartenansicht</h1>
			<p class="lede">Gruppiere die Karten nach Serie, Status, Seltenheit oder anderen Merkmalen und vergleiche die Details direkt in einer Tabelle.</p>
		</div>

		<div class="table-controls">
			<label>
				<span>Gruppieren nach</span>
				<select @bind="groupBy">
					<option value="set">Serie / Set</option>
					<option value="status">Status</option>
					<option value="rarity">Seltenheit</option>
					<option value="none">Keine Gruppierung</option>
				</select>
			</label>

			<label>
				<span>Filter</span>
				<input @bind="searchText" @bind:event="oninput" placeholder="Name, Nummer, Set, Status..." />
			</label>

			<label>
				<span>Review-Status</span>
				<select @bind="selectedReviewStatus">
					<option value="">Alle Review-Status</option>
					@foreach (var reviewStatus in AvailableReviewStatuses)
					{
						<option value="@reviewStatus">@GetReviewStatusLabel(reviewStatus)</option>
					}
				</select>
			</label>
		</div>
	</header>

	@if (isLoading)
	{
		<p>Lade Karten...</p>
	}
	else if (cards.Count == 0)
	{
		<div class="empty-state">
			<h2>Keine Karten gefunden</h2>
			<p>Es liegen aktuell keine Karten fuer die Tabellenansicht vor.</p>
		</div>
	}
	else
	{
		@foreach (var group in GetGroupedCards())
		{
			<section class="table-group">
				<div class="table-group-header">
					<h2>@group.Key</h2>
					<span>@group.Count Karte(n)</span>
				</div>

				<div class="cards-table-wrapper">
					<table class="cards-table">
						<thead>
							<tr>
								<th>Bild</th>
								<th>Name</th>
								<th>Nummer</th>
								<th>Set</th>
								<th>Status</th>
								<th>Review-Status</th>
								<th>Seltenheit</th>
								<th>Confidence</th>
								<th>Details</th>
							</tr>
						</thead>
						<tbody>
							@foreach (var card in group.Items)
							{
								<tr>
									<td>
										<button type="button" class="table-thumb-button" @onclick="() => OpenImagePreview(card)">
											<img class="table-thumb" src="@card.ImageUrl" alt="@card.ImageFileName" loading="lazy" />
										</button>
									</td>
									<td>
										<div class="table-primary">@(card.CardName ?? Path.GetFileNameWithoutExtension(card.ImageFileName))</div>
										<div class="table-secondary">@card.ImageFileName</div>
									</td>
									<td>@(card.CardNumber ?? "-")</td>
									<td>
										<select
											class="table-set-select"
											value="@GetSetSelectionValue(card)"
											@onchange="async args => await OnSetChangedAsync(card, args)"
											disabled="@IsSaving(card)">
											<option value="">Ohne Set</option>
											@foreach (var series in knownSeries)
											{
												<option value="@series">@series</option>
											}
										</select>
										@if (IsSaving(card))
										{
											<div class="table-set-hint">Speichert...</div>
										}
									</td>
									<td><span class="table-status @GetStatusClass(card.AnalysisStatus)">@GetStatusLabel(card.AnalysisStatus)</span></td>
									<td><span class="table-status @GetReviewStatusClass(card.ReviewStatus)">@GetReviewStatusLabel(card.ReviewStatus)</span></td>
									<td>@(card.Rarity ?? "-")</td>
									<td>@card.Confidence.ToString("0.00")</td>
									<td>
										@if (HasDetails(card))
										{
											var isExpanded = IsExpanded(card);
											<button type="button" class="table-details-toggle" @onclick="() => ToggleDetails(card)">
												@(isExpanded ? "Details ausblenden" : "Details anzeigen")
											</button>

											@if (isExpanded)
											{
												@if (!string.IsNullOrWhiteSpace(card.ErrorMessage))
												{
													<div class="table-error">@card.ErrorMessage</div>
												}
												else if (!string.IsNullOrWhiteSpace(card.ReasoningSummary))
												{
													<div class="table-details">@card.ReasoningSummary</div>
												}
											}
										}
										else
										{
											<span class="table-details-empty">-</span>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</section>
		}
	}
</div>

@if (previewImageUrl is not null)
{
	<div class="table-image-preview-backdrop" @onclick="CloseImagePreview">
		<div class="table-image-preview-dialog" @onclick:stopPropagation="true">
			<button type="button" class="table-image-preview-close" @onclick="CloseImagePreview" aria-label="Vorschau schliessen">Schliessen</button>
			<img class="table-image-preview" src="@previewImageUrl" alt="@previewImageAlt" />
			@if (!string.IsNullOrWhiteSpace(previewImageTitle))
			{
				<div class="table-image-preview-caption">@previewImageTitle</div>
			}
		</div>
	</div>
}

@code {
	private List<CardListItem> cards = [];
	private bool isLoading = true;
	private string groupBy = "set";
	private string searchText = string.Empty;
	private string selectedReviewStatus = string.Empty;
	private string? expandedCardKey;
	private IReadOnlyList<string> knownSeries = Array.Empty<string>();
	private string? savingCardKey;
	private string? previewImageUrl;
	private string? previewImageAlt;
	private string? previewImageTitle;

	protected override async Task OnInitializedAsync()
	{
		knownSeries = await CardCatalogService.GetKnownSeriesAsync();
		cards = (await CardCatalogService.GetCardsAsync()).ToList();
		isLoading = false;
	}

	private IEnumerable<string> AvailableReviewStatuses => cards
		.Select(card => card.ReviewStatus)
		.Where(reviewStatus => !string.IsNullOrWhiteSpace(reviewStatus))
		.Distinct(StringComparer.OrdinalIgnoreCase)
		.OrderBy(GetReviewStatusLabel, StringComparer.OrdinalIgnoreCase);

	private IEnumerable<CardGroup> GetGroupedCards()
	{
		var filteredCards = cards
			.Where(MatchesSearch)
			.Where(MatchesReviewStatus)
			.OrderBy(card => card.SetName ?? string.Empty, StringComparer.OrdinalIgnoreCase)
			.ThenBy(card => card.CardNumber ?? string.Empty, StringComparer.OrdinalIgnoreCase)
			.ThenBy(card => card.CardName ?? card.ImageFileName, StringComparer.OrdinalIgnoreCase);

		if (groupBy == "none")
		{
			var items = filteredCards.ToList();
			return items.Count == 0 ? [] : [new CardGroup("Alle Karten", items)];
		}

		var groups = filteredCards.GroupBy(GetGroupKey);

		if (groupBy == "set")
		{
			return groups
				.OrderBy(group => GetSeriesGroupRank(group.Key))
				.ThenBy(group => group.Key, StringComparer.OrdinalIgnoreCase)
				.Select(group => new CardGroup(group.Key, group.ToList()));
		}

		return groups
			.OrderBy(group => group.Key, StringComparer.OrdinalIgnoreCase)
			.Select(group => new CardGroup(group.Key, group.ToList()));
	}

	private int GetSeriesGroupRank(string seriesName)
	{
		for (var index = 0; index < knownSeries.Count; index++)
		{
			if (string.Equals(knownSeries[index], seriesName, StringComparison.OrdinalIgnoreCase))
			{
				return index;
			}
		}

		return int.MaxValue;
	}

	private bool MatchesSearch(CardListItem card)
	{
		if (string.IsNullOrWhiteSpace(searchText))
		{
			return true;
		}

		var query = searchText.Trim();
		var haystack = string.Join(
			' ',
			new[]
			{
				card.CardName,
				card.CardNumber,
				card.SetName,
				card.Rarity,
				card.AnalysisStatus,
				card.ImageFileName
			}.Where(value => !string.IsNullOrWhiteSpace(value)));

		return haystack.Contains(query, StringComparison.OrdinalIgnoreCase);
	}

	private bool MatchesReviewStatus(CardListItem card)
	{
		return string.IsNullOrWhiteSpace(selectedReviewStatus)
			|| string.Equals(card.ReviewStatus, selectedReviewStatus, StringComparison.OrdinalIgnoreCase);
	}

	private static bool HasDetails(CardListItem card)
	{
		return !string.IsNullOrWhiteSpace(card.ErrorMessage)
			|| !string.IsNullOrWhiteSpace(card.ReasoningSummary);
	}

	private bool IsExpanded(CardListItem card)
	{
		return string.Equals(expandedCardKey, card.ImageFileName, StringComparison.Ordinal);
	}

	private void ToggleDetails(CardListItem card)
	{
		expandedCardKey = IsExpanded(card) ? null : card.ImageFileName;
	}

	private void OpenImagePreview(CardListItem card)
	{
		previewImageUrl = card.ImageUrl;
		previewImageAlt = card.ImageFileName;
		previewImageTitle = card.CardName ?? Path.GetFileNameWithoutExtension(card.ImageFileName);
	}

	private void CloseImagePreview()
	{
		previewImageUrl = null;
		previewImageAlt = null;
		previewImageTitle = null;
	}

	private string GetSetSelectionValue(CardListItem card)
	{
		return knownSeries.Contains(card.SetName ?? string.Empty, StringComparer.OrdinalIgnoreCase)
			? card.SetName ?? string.Empty
			: string.Empty;
	}

	private bool IsSaving(CardListItem card)
	{
		return string.Equals(savingCardKey, card.ImageFileName, StringComparison.Ordinal);
	}

	private async Task OnSetChangedAsync(CardListItem card, ChangeEventArgs args)
	{
		var newSetName = args.Value?.ToString();
		savingCardKey = card.ImageFileName;

		try
		{
			await CardCatalogService.UpdateSetNameAsync(card.ImageFileName, newSetName);

			var index = cards.FindIndex(entry => string.Equals(entry.ImageFileName, card.ImageFileName, StringComparison.Ordinal));
			if (index >= 0)
			{
				cards[index] = new CardListItem
				{
					ImageFileName = card.ImageFileName,
					ImageUrl = card.ImageUrl,
					AnalysisStatus = card.AnalysisStatus,
					CardName = card.CardName,
					CardNumber = card.CardNumber,
					SetName = string.IsNullOrWhiteSpace(newSetName) ? null : newSetName,
					Rarity = card.Rarity,
					Confidence = card.Confidence,
					ReasoningSummary = card.ReasoningSummary,
					DetectedText = card.DetectedText,
					ScannedAtUtc = card.ScannedAtUtc,
					ErrorMessage = card.ErrorMessage,
					ReviewStatus = card.ReviewStatus
				};
			}
		}
		finally
		{
			savingCardKey = null;
		}
	}

	private string GetGroupKey(CardListItem card) => groupBy switch
	{
		"status" => GetStatusLabel(card.AnalysisStatus),
		"rarity" => card.Rarity ?? "Unbekannt",
		_ => card.SetName ?? "Ohne Set"
	};

	private static string GetStatusClass(string status) => status.ToLowerInvariant() switch
	{
		"ok" => "status-ok",
		"uncertain" => "status-uncertain",
		"pending" => "status-pending",
		_ => "status-failed"
	};

	private static string GetStatusLabel(string status) => status.ToLowerInvariant() switch
	{
		"ok" => "Erkannt",
		"uncertain" => "Unsicher",
		"pending" => "Kein Sidecar",
		_ => "Fehler"
	};

	private static string GetReviewStatusClass(string reviewStatus) => reviewStatus.ToLowerInvariant() switch
	{
		"verified" => "status-ok",
		"incorrect" => "status-failed",
		_ => "status-pending"
	};

	private static string GetReviewStatusLabel(string reviewStatus) => reviewStatus.ToLowerInvariant() switch
	{
		"verified" => "Bestätigt",
		"incorrect" => "Fehlerhaft",
		_ => "Nicht geprüft"
	};

	private sealed record CardGroup(string Key, List<CardListItem> Items)
	{
		public int Count => Items.Count;
	}
}