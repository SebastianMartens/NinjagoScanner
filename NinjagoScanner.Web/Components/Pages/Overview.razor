@page "/"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject PictureServiceClient PictureServiceClient
@inject CollectionQueryService CollectionQueryService
@inject GamificationService GamificationService
@inject NavigationManager NavigationManager

<PageTitle>Ninjago Scanner</PageTitle>

<div class="overview-page">
	<header class="overview-header">
		<p class="eyebrow">Ninjago Scanner</p>
		<h1>Übersicht</h1>
		<p class="lede">Starte hier den Gemini-Scan neuer Kartenfotos.</p>
		<div class="mt-3 d-flex gap-2 align-items-center flex-wrap">
			<button class="btn btn-primary" type="button" disabled="@isScanning" @onclick="StartGeminiScanAsync">
				@(isScanning ? "Gemini-Scan laeuft..." : "Gemini-Suche starten")
			</button>
			@if (!string.IsNullOrWhiteSpace(scanStatusMessage))
			{
				<span>@scanStatusMessage</span>
			}
		</div>
	</header>

	@if (!string.IsNullOrWhiteSpace(summaryLoadError))
	{
		<div class="empty-state">
			<h2>Katalogdaten konnten nicht geladen werden</h2>
			<p class="table-secondary">@summaryLoadError</p>
		</div>
	}
	else
	{
		<section class="catalog-statistics">
			<div class="series-summary-header">
				<h2>Katalogstatistik</h2>
			</div>

			@if (isSummaryLoading)
			{
				<p>Lade Katalogstatistik...</p>
			}
			else
			{
				<div class="collection-stats">
					<span>@seriesSummary.TotalCatalogCards Karte(n) im Katalog</span>
					<span>@seriesSummary.OwnedCatalogCards im Besitz</span>
					<span>@seriesSummary.TotalPhotos Foto(s)</span>
				</div>
				<div class="collection-stats">
					<span>Analyse: @seriesSummary.AnalysisStatusCounts.Ok ok</span>
					<span>@seriesSummary.AnalysisStatusCounts.Uncertain unsicher</span>
					<span>@seriesSummary.AnalysisStatusCounts.Failed fehlgeschlagen</span>
					<span>@seriesSummary.AnalysisStatusCounts.NotAnalyzed noch nicht analysiert</span>
				</div>
				<div class="collection-stats">
					<span>Review: @seriesSummary.ReviewStatusCounts.Unreviewed ungeprueft</span>
					<span>@seriesSummary.ReviewStatusCounts.Verified bestaetigt</span>
					<span>@seriesSummary.ReviewStatusCounts.Incorrect fehlerhaft</span>
				</div>
			}
		</section>

		@if (_rank is not null)
		{
			<section class="rank-status-block">
				<div class="section-label">Rang &amp; Erfahrung</div>
				<div class="rank-status-row" style="--rank-accent: @_rank.AccentColor;">
					<div class="rank-hero-badge">@_rank.Glyph</div>
					<div class="rank-status-body">
						<div class="rank-status-meta">
							<span class="rank-status-title">Rang @_rank.Level · @_rank.Name</span>
							<span>@_xp XP · @RankStatusToNextLabel()</span>
						</div>
						<div class="rank-progress-track">
							<div class="rank-progress-fill" style="width: @(RankStatusPercent())%;"></div>
						</div>
					</div>
				</div>
			</section>
		}

		<section class="series-summary">
			<div class="series-summary-header">
				<h2>Serienübersicht</h2>
			</div>

			@if (isSummaryLoading)
			{
				<p>Lade Serienübersicht...</p>
			}
			else if (seriesSummary.Series.Count == 0)
			{
				<p class="table-secondary">Keine Serien im Katalog gefunden.</p>
			}
			else
			{
				<div class="series-tile-grid">
					@foreach (var series in seriesSummary.Series)
					{
						<div class="series-tile" @onclick="() => GoToSeries(series.SeriesName)">
							<h3>@series.SeriesName</h3>
							<div class="series-tile-progress">
								<div class="series-tile-progress-bar" style="width: @(OwnedPercent(series))%"></div>
							</div>
							<div class="series-tile-stats">
								<span>@series.OwnedCards / @series.TotalCards Karten</span>
								<span>@series.TotalPhotos Foto(s)</span>
							</div>
						</div>
					}
				</div>

				@if (seriesSummary.UnknownSeriesPhotoCount > 0)
				{
					<p class="series-unknown-note">@seriesSummary.UnknownSeriesPhotoCount Foto(s) ohne erkannte Serie ("unbekannte Serie").</p>
				}
			}
		</section>
	}
</div>

@code {
	private bool isScanning;
	private string? scanStatusMessage;
	private string? summaryLoadError;

	private SeriesSummaryResult seriesSummary = new() { Series = Array.Empty<SeriesSummaryItem>() };
	private bool isSummaryLoading = true;
	private RankDefinition? _rank;
	private int _xp;

	protected override async Task OnInitializedAsync()
	{
		try
		{
			seriesSummary = await CollectionQueryService.GetSeriesSummaryAsync();
			summaryLoadError = null;
		}
		catch (Exception exception)
		{
			summaryLoadError = $"Katalog-/PictureService nicht erreichbar: {exception.Message}";
			seriesSummary = new SeriesSummaryResult { Series = Array.Empty<SeriesSummaryItem>() };
		}

		// Kept out of the try/catch above: a gamification-only hiccup must not wipe out an
		// already-successfully-loaded series summary and show the "unreachable" error state for it.
		try
		{
			_xp = await GamificationService.GetXpAsync();
			_rank = GamificationService.GetRank(_xp);
		}
		catch (Exception)
		{
			_rank = null;
		}

		isSummaryLoading = false;
	}

	private int RankStatusPercent()
	{
		if (_rank is null)
		{
			return 0;
		}

		var next = RankDefinitions.Next(_rank);
		if (next is null)
		{
			return 100;
		}

		var span = next.MinXp - _rank.MinXp;
		return span <= 0 ? 100 : Math.Clamp((int)Math.Round(100.0 * (_xp - _rank.MinXp) / span), 0, 100);
	}

	private string RankStatusToNextLabel()
	{
		if (_rank is null)
		{
			return string.Empty;
		}

		var next = RankDefinitions.Next(_rank);
		return next is null ? "alles erreicht" : $"noch {next.MinXp - _xp} XP bis {next.Name}";
	}

	private async Task StartGeminiScanAsync()
	{
		isScanning = true;
		scanStatusMessage = null;

		try
		{
			var summary = await PictureServiceClient.ScanAsync();

			scanStatusMessage = ScanStatusMessageFormatter.BuildMessage(summary);
		}
		catch (Exception exception)
		{
			scanStatusMessage = $"Scan fehlgeschlagen: {exception.Message}";
		}
		finally
		{
			isScanning = false;
		}
	}

	private static int OwnedPercent(SeriesSummaryItem series)
	{
		return series.TotalCards > 0 ? (int)Math.Round(100.0 * series.OwnedCards / series.TotalCards) : 0;
	}

	private void GoToSeries(string seriesName)
	{
		NavigationManager.NavigateTo($"/collection?series={Uri.EscapeDataString(seriesName)}");
	}
}
