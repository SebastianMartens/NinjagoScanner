@page "/upload"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IDisposable
@using System.Globalization
@inject PictureServiceClient PictureServiceClient
@inject CollectionQueryService CollectionQueryService
@inject GamificationService GamificationService
@inject GamificationCelebrationCenter CelebrationCenter

<PageTitle>Foto-Upload</PageTitle>

<div class="upload-page">
    <header class="upload-header">
        <div>
            <p class="eyebrow">Ninjago Scanner</p>
            <h1>Foto direkt vom Handy hochladen</h1>
            <p class="lede">
                Waehle auf Android direkt die Kamera oder eine vorhandene Aufnahme.
                Das Bild wird hochgeladen und automatisch analysiert.
            </p>
        </div>
    </header>

    <section class="upload-card">
        <label class="upload-field">
            <span>Foto</span>
            <InputFile OnChange="OnFileChanged" @attributes="captureAttributes" accept="image/*" />
        </label>

        @if (selectedFile is not null)
        {
            <p class="upload-selection">
                Ausgewaehlt: <strong>@selectedFile.Name</strong> (@FormatFileSize(selectedFile.Size))
            </p>
        }

        <p class="upload-limit">
            Maximale Dateigroesse: @FormatFileSize(maxUploadBytes)
        </p>

        <div class="upload-actions">
            <button class="btn btn-primary" type="button" @onclick="UploadSelectedFileAsync" disabled="@(isUploading || selectedFile is null)">
                @(isUploading ? "Upload laeuft..." : "Foto hochladen")
            </button>
            <a class="btn btn-outline-secondary" href="/">Zur Kartenansicht</a>
        </div>

        @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <p class="upload-success">@successMessage</p>
        }

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <p class="upload-error">@errorMessage</p>
        }
    </section>

    <section class="upload-card">
        <h2>Viele Fotos auf einmal hochladen</h2>
        <p class="upload-limit">
            Die Fotos werden nur gespeichert, nicht analysiert &ndash; die Analyse startest du danach auf der
            Uebersicht mit &bdquo;Gemini-Suche starten&ldquo;. Dateien, deren Name in der Sammlung schon vorkommt,
            werden uebersprungen; nach einem Abbruch kannst du dieselbe Auswahl einfach erneut hochladen.
            Der Tab muss waehrenddessen geoeffnet bleiben.
        </p>

        <label class="upload-check">
            <input type="checkbox" checked="@selectFolder" disabled="@isBatchRunning" @onchange="OnSelectFolderChanged" />
            <span>Ganzen Ordner auswaehlen</span>
        </label>

        <label class="upload-field">
            <span>Fotos (max. @MaxBatchFiles.ToString("N0", German) pro Auswahl)</span>
            @* @key: a fresh input clears the browser's selection, so the same files can be picked again (retry) after a run or a folder-mode toggle. *@
            <InputFile @key="batchInputKey" OnChange="OnBatchFilesChanged" @attributes="batchInputAttributes" disabled="@isBatchRunning" />
        </label>

        @if (batchFiles.Count > 0 && batchUpload is null)
        {
            <p class="upload-selection">
                Ausgewaehlt: <strong>@batchFiles.Count.ToString("N0", German)</strong> Dateien
            </p>
        }

        <div class="upload-actions">
            <button class="btn btn-primary" type="button" @onclick="StartBatchUploadAsync" disabled="@(isBatchRunning || batchFiles.Count == 0)">
                @(isBatchRunning ? "Batch-Upload laeuft..." : "Fotos hochladen")
            </button>
        </div>

        @if (batchUpload is not null)
        {
            <p class="upload-progress">
                @batchUpload.Processed.ToString("N0", German) von @batchUpload.Total.ToString("N0", German) verarbeitet
            </p>
            <p class="upload-selection">
                Hochgeladen: @batchUpload.Uploaded.ToString("N0", German) &middot;
                Uebersprungen: @batchUpload.Skipped.ToString("N0", German) &middot;
                Fehlgeschlagen: @batchUpload.Failed.ToString("N0", German)
            </p>

            @if (!isBatchRunning)
            {
                @if (batchUpload.WasCancelled)
                {
                    <p class="upload-error">Der Upload wurde abgebrochen.</p>
                }
                else
                {
                    <p class="upload-success">Batch-Upload abgeschlossen.</p>
                }

                @if (batchUpload.Skipped > 0)
                {
                    <details class="upload-result-list">
                        <summary>Uebersprungen (Dateiname bereits vorhanden): @batchUpload.Skipped.ToString("N0", German)</summary>
                        <ul>
                            @foreach (var name in batchUpload.SkippedNames)
                            {
                                <li>@name</li>
                            }
                        </ul>
                    </details>
                }

                @if (batchUpload.Failed > 0)
                {
                    <details class="upload-result-list" open>
                        <summary>Fehlgeschlagen: @batchUpload.Failed.ToString("N0", German)</summary>
                        <ul>
                            @foreach (var failure in batchUpload.FailedItems)
                            {
                                <li>@failure.FileName &ndash; @failure.Reason</li>
                            }
                        </ul>
                    </details>
                }
            }
        }

        @if (!string.IsNullOrWhiteSpace(batchErrorMessage))
        {
            <p class="upload-error">@batchErrorMessage</p>
        }
    </section>
</div>

@code {
    private readonly Dictionary<string, object> captureAttributes = new(StringComparer.OrdinalIgnoreCase)
    {
        ["capture"] = "environment"
    };

    private const int MaxBatchFiles = 10_000;
    private static readonly CultureInfo German = CultureInfo.GetCultureInfo("de-DE");
    private static readonly TimeSpan RenderInterval = TimeSpan.FromMilliseconds(250);

    // No capture hint: the batch input is for picking existing files, not for taking a photo.
    private readonly Dictionary<string, object> batchInputAttributes = new(StringComparer.OrdinalIgnoreCase)
    {
        ["multiple"] = true,
        ["accept"] = "image/*"
    };

    private readonly CancellationTokenSource disposeCancellation = new();

    private IReadOnlyList<IBrowserFile> batchFiles = [];
    private BatchUpload? batchUpload;
    private bool isBatchRunning;
    private int batchInputKey;
    private bool selectFolder;
    private bool isDisposed;
    private string? batchErrorMessage;
    private DateTime lastRenderUtc;

    private IBrowserFile? selectedFile;
    private bool isUploading;
    private string? successMessage;
    private string? errorMessage;
    private long maxUploadBytes;

    protected override void OnInitialized()
    {
        maxUploadBytes = PictureServiceClient.MaxUploadBytes;
    }

    private void OnFileChanged(InputFileChangeEventArgs eventArgs)
    {
        selectedFile = eventArgs.FileCount > 0 ? eventArgs.File : null;
        successMessage = null;
        errorMessage = null;
    }

    private void OnSelectFolderChanged(ChangeEventArgs eventArgs)
    {
        selectFolder = eventArgs.Value is true;
        batchInputKey++;
        batchInputAttributes.Remove("webkitdirectory");
        if (selectFolder)
        {
            batchInputAttributes["webkitdirectory"] = true;
        }

        batchFiles = [];
        batchUpload = null;
        batchErrorMessage = null;
    }

    private void OnBatchFilesChanged(InputFileChangeEventArgs eventArgs)
    {
        batchUpload = null;
        batchErrorMessage = null;

        if (eventArgs.FileCount > MaxBatchFiles)
        {
            batchFiles = [];
            batchErrorMessage = $"Zu viele Dateien ausgewaehlt: maximal {MaxBatchFiles.ToString("N0", German)} pro Batch-Upload.";
            return;
        }

        batchFiles = eventArgs.GetMultipleFiles(MaxBatchFiles);
    }

    private async Task StartBatchUploadAsync()
    {
        if (batchFiles.Count == 0 || isBatchRunning)
        {
            return;
        }

        var cancellationToken = disposeCancellation.Token;
        isBatchRunning = true;
        batchErrorMessage = null;
        batchUpload = null;

        try
        {
            // Looked up once, before the first upload: a batch that couldn't learn which names
            // already exist would re-upload (duplicate) everything, so it doesn't start at all.
            var existingNames = await PictureServiceClient.ListSourceFileNamesAsync(cancellationToken);

            var files = batchFiles.Select(file => new BatchUploadFile(file.Name, async token =>
            {
                // A file above the limit must reach PictureServiceClient's German size check
                // rather than fail inside OpenReadStream, so the stream is opened with at least
                // the file's own size; nothing is read until the client has validated it.
                await using var stream = file.OpenReadStream(Math.Max(maxUploadBytes, file.Size), token);
                await PictureServiceClient.UploadPhotoForBatchAsync(file.Name, file.Size, stream, token);
            })).ToList();

            var upload = new BatchUpload(files, existingNames);
            upload.Changed += OnBatchProgressChanged;
            batchUpload = upload;
            lastRenderUtc = DateTime.UtcNow;

            await upload.RunAsync(cancellationToken);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            // The circuit is going away; nothing left to show.
        }
        catch (Exception exception)
        {
            batchErrorMessage = $"Batch-Upload konnte nicht gestartet werden: {exception.Message}";
        }
        finally
        {
            isBatchRunning = false;
            if (batchUpload is not null)
            {
                batchUpload.Changed -= OnBatchProgressChanged;
            }

            // The picked files were consumed (or failed); a new run needs a new pick.
            batchInputKey++;
            batchFiles = [];
        }
    }

    // A 10,000-file batch would otherwise push 10,000 renders over the SignalR circuit.
    private void OnBatchProgressChanged()
    {
        if (isDisposed || DateTime.UtcNow - lastRenderUtc < RenderInterval)
        {
            return;
        }

        lastRenderUtc = DateTime.UtcNow;
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        isDisposed = true;
        disposeCancellation.Cancel();
        disposeCancellation.Dispose();
    }

    private async Task UploadSelectedFileAsync()
    {
        if (selectedFile is null)
        {
            errorMessage = "Bitte zuerst ein Foto auswaehlen.";
            successMessage = null;
            return;
        }

        isUploading = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            // Best-effort: a gamification hiccup (e.g. CatalogService briefly unreachable) must
            // never turn a successful upload into a reported failure, so it's captured outside the
            // upload's own try/catch semantics below.
            var xpBefore = await TryGetXpBeforeAsync();

            // Streams the photo bytes straight to PictureService over gRPC - they never pass
            // through browser-to-storage; PictureService assigns the photo ID and triggers
            // AI Analysis once the stream completes.
            await using var stream = selectedFile.OpenReadStream(maxUploadBytes);
            var card = await PictureServiceClient.UploadPhotoAsync(selectedFile.Name, selectedFile.Size, stream);

            successMessage = $"Upload erfolgreich: {card.SourceFileName} (Status: {card.AnalysisStatus}).";
            selectedFile = null;

            if (xpBefore is { } xp)
            {
                await TryCelebrateMatchAsync(card, xp);
            }
        }
        catch (InvalidOperationException exception)
        {
            errorMessage = exception.Message;
        }
        catch (Exception exception)
        {
            errorMessage = $"Upload fehlgeschlagen: {exception.Message}";
        }
        finally
        {
            isUploading = false;
        }
    }

    /// <summary>
    /// Raises the unlock-moment overlay when a scan matched a catalog card (web-photo-upload
    /// "after a successful scan+match, raises the unlock-feedback event") - new card vs. duplicate
    /// is read off the post-upload owned-copies count for that card, which already includes the
    /// photo just uploaded.
    /// </summary>
    private async Task TryCelebrateMatchAsync(CardListItem card, int xpBefore)
    {
        if (string.IsNullOrWhiteSpace(card.SetName) || string.IsNullOrWhiteSpace(card.CardNumber))
        {
            return;
        }

        try
        {
            var overview = await CollectionQueryService.GetCollectionOverviewAsync();
            var matchedKey = CollectionQueryService.BuildOwnershipKey(card.SetName, card.CardNumber);
            var matchedCard = overview.Cards.FirstOrDefault(item =>
                CollectionQueryService.BuildOwnershipKey(item.Series, item.CardNumber) == matchedKey);

            if (matchedCard is null || matchedCard.OwnedCopies <= 0)
            {
                return;
            }

            var evaluation = await GamificationService.EvaluateAsync(xpBefore);
            var kind = matchedCard.OwnedCopies == 1 ? UnlockCelebrationKind.NewCard : UnlockCelebrationKind.Duplicate;
            CelebrationCenter.CelebrateCard(kind, matchedCard.CardName, matchedCard.Series, matchedCard.CardNumber, card.Rarity, matchedCard.OwnedCopies, evaluation);
        }
        catch (Exception)
        {
            // The upload itself already succeeded - a missed celebration isn't worth reporting as
            // an upload failure.
        }
    }

    private async Task<int?> TryGetXpBeforeAsync()
    {
        try
        {
            return await GamificationService.GetXpAsync();
        }
        catch (Exception)
        {
            return null;
        }
    }

    private static string FormatFileSize(long bytes)
    {
        if (bytes >= 1024 * 1024)
        {
            return $"{bytes / (1024d * 1024d):0.##} MB";
        }

        if (bytes >= 1024)
        {
            return $"{bytes / 1024d:0.##} KB";
        }

        return $"{bytes} B";
    }
}
