@page "/review"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Grpc.Core
@inject CatalogServiceClient CatalogServiceClient
@inject PictureServiceClient PictureServiceClient
@inject CollectionQueryService CollectionQueryService
@inject GamificationService GamificationService
@inject GamificationCelebrationCenter CelebrationCenter

<PageTitle>Karten-Review</PageTitle>

<div class="review-page">
	<header class="review-header">
		<div>
			<p class="eyebrow">Ninjago Scanner</p>
			<h1>Karten-Review</h1>
			<p class="lede">Vergleiche alle Fotos einer Karte, bestätige sie in einem Klick oder korrigiere die Serie.</p>
		</div>

		@if (!isLoading && session.Groups.Count > 0)
		{
			<div class="review-nav">
				<label class="review-filter">
					<span>Status-Filter</span>
					<select value="@session.ReviewStatusFilter" @onchange="OnReviewStatusFilterChanged">
						<option value="@AllFilterValue">Alle</option>
						<option value="@ReviewStatuses.Unreviewed">@GetReviewStatusLabel(ReviewStatuses.Unreviewed)</option>
						<option value="@ReviewStatuses.Verified">@GetReviewStatusLabel(ReviewStatuses.Verified)</option>
						<option value="@ReviewStatuses.Incorrect">@GetReviewStatusLabel(ReviewStatuses.Incorrect)</option>
					</select>
				</label>
				<label class="review-filter">
					<span>Analyse-Filter</span>
					<select value="@session.AnalysisStatusFilter" @onchange="OnAnalysisStatusFilterChanged">
						<option value="@AllFilterValue">Alle</option>
						<option value="@AnalysisStatuses.Ok">@GetAnalysisStatusLabel(AnalysisStatuses.Ok)</option>
						<option value="@AnalysisStatuses.Uncertain">@GetAnalysisStatusLabel(AnalysisStatuses.Uncertain)</option>
						<option value="@AnalysisStatuses.Failed">@GetAnalysisStatusLabel(AnalysisStatuses.Failed)</option>
						<option value="@AnalysisStatuses.NotAnalyzed">@GetAnalysisStatusLabel(AnalysisStatuses.NotAnalyzed)</option>
					</select>
				</label>
				<label class="review-filter">
					<span>Suche</span>
					<input value="@session.SearchText" placeholder="Kartennummer oder Kartenname" @oninput="OnSearchTextChanged" />
				</label>
				<span class="review-nav-position">@(FilteredGroups.Count == 0 ? 0 : session.CurrentIndex + 1) / @FilteredGroups.Count</span>
				<button class="review-btn" type="button" disabled="@(session.CurrentIndex <= 0)" @onclick="GoToPreviousAsync">← Zurueck</button>
				<button class="review-btn" type="button" disabled="@(session.CurrentIndex >= FilteredGroups.Count - 1)" @onclick="GoToNextAsync">Weiter →</button>
			</div>
		}
	</header>

	@if (isLoading)
	{
		<p>Lade Karten...</p>
	}
	else if (session.Groups.Count == 0)
	{
		<div class="empty-state">
			<h2>Keine Fotos vorhanden</h2>
			<p>Es sind derzeit keine gescannten Karten zum Prüfen vorhanden.</p>
		</div>
	}
	else if (CurrentGroup is null)
	{
		<div class="empty-state">
			<h2>Alle Karten geprüft</h2>
			<p>Du hast das Ende der Liste erreicht.</p>
			<button class="review-btn" type="button" @onclick="RestartFromBeginningAsync">Von vorne beginnen</button>
		</div>
	}
	else
	{
		var group = CurrentGroup;

		<div class="review-group-summary">
			<h2 class="review-group-title">@GroupTitle(group)</h2>
			<div class="review-confirm-all">
			<button class="btn btn-primary" type="button" disabled="@isConfirmingAll" @onclick="ConfirmAllAsync">
				@(isConfirmingAll ? "Bestätigt..." : "Alle bestätigen")
			</button>
		</div>
			<span class="review-group-count">@group.Photos.Count Foto(s)</span>
		</div>

		@if (HasHiddenPhotos(group))
		{
			<p class="review-group-more-message">Diese Gruppe hat mehr als @MaxDisplayedPhotosPerGroup Fotos. Es werden nur die ersten @MaxDisplayedPhotosPerGroup angezeigt.</p>
		}

		<div class="review-photo-grid">
			@foreach (var photo in DisplayedPhotos(group))
			{
				var isBusy = IsBusy(photo);

				<article class="review-photo-tile">
					<div class="review-photo-image">
						@if (!string.IsNullOrEmpty(photo.ImageUrl))
						{
							<img src="@photo.ImageUrl" alt="@photo.SourceFileName" loading="lazy" />
						}
					</div>

					<div class="review-photo-body">
						<p class="review-photo-meta">
							<span class="review-photo-series">@(photo.SetName ?? "Ohne Serie")</span>
							· @(photo.CardName ?? Path.GetFileNameWithoutExtension(photo.SourceFileName))
							· <span class="review-photo-number">Nr. @(photo.CardNumber ?? "-")</span>
						</p>

						<div class="review-status-control" role="group" aria-label="Review-Status">
							<button type="button" class="@GetSegmentClass(photo, ReviewStatuses.Unreviewed)" disabled="@isBusy" @onclick="() => SetReviewStatusAsync(photo, ReviewStatuses.Unreviewed)">@GetReviewStatusLabel(ReviewStatuses.Unreviewed)</button>
							<button type="button" class="@GetSegmentClass(photo, ReviewStatuses.Verified)" disabled="@isBusy" @onclick="() => SetReviewStatusAsync(photo, ReviewStatuses.Verified)">@GetReviewStatusLabel(ReviewStatuses.Verified)</button>
							<button type="button" class="@GetSegmentClass(photo, ReviewStatuses.Incorrect)" disabled="@isBusy" @onclick="() => SetReviewStatusAsync(photo, ReviewStatuses.Incorrect)">@GetReviewStatusLabel(ReviewStatuses.Incorrect)</button>
						</div>

						<div class="review-series-picker" role="group" aria-label="Serie zuweisen">
							@foreach (var series in knownSeries)
							{
								<button type="button" class="review-series-cell" disabled="@isBusy" title="@series" @onclick="() => PickSeriesAsync(photo, series)">
									@if (SeriesLogos.TryGetValue(series, out var logo) && !string.IsNullOrEmpty(logo.ImageFile))
									{
										<img class="review-series-cell-logo" src="@($"/images/{logo.ImageFile}")" alt="@logo.Caption" />
									}
									else
									{
										<span class="review-series-cell-label">@series</span>
									}
								</button>
							}
						</div>

						<form class="review-card-number-edit" @onsubmit="() => SaveCardNumberAsync(photo)">
							<label>
								<span>Kartennummer</span>
								<input type="text" class="review-card-number-input" value="@GetCardNumberDraft(photo)" disabled="@isBusy"
									@oninput="e => cardNumberDrafts[photo.PhotoId] = e.Value?.ToString() ?? string.Empty" />
							</label>
							<button class="review-btn" type="submit" disabled="@isBusy">Nummer speichern</button>
						</form>

						<label class="review-language-control">
							<span>Sprache</span>
							<select value="@photo.Language" disabled="@isBusy" @onchange="e => SaveLanguageAsync(photo, e.Value?.ToString())">
								<option value="@Languages.German">Deutsch</option>
								<option value="@Languages.English">Englisch</option>
								<option value="@Languages.Polish">Polnisch</option>
								<option value="@Languages.Unknown">Unbekannt</option>
							</select>
						</label>

						<button class="review-details-toggle" type="button" @onclick="() => ToggleDetails(photo)">
							@(IsExpanded(photo) ? "Details ausblenden" : "Details anzeigen")
						</button>

						@if (IsExpanded(photo))
						{
							<div class="review-details">
								<span>Seltenheit: @(photo.Rarity ?? "-")</span>
								@{ var details = GetDetails(photo); }
								@if (details is null)
								{
									<span>Lade Details...</span>
								}
								else
								{
									@if (!string.IsNullOrWhiteSpace(details.ErrorMessage))
									{
										<span>Fehler: @details.ErrorMessage</span>
									}
									@if (details.ScannedAtUtc is not null)
									{
										<span>Gescannt: @details.ScannedAtUtc.Value.LocalDateTime</span>
									}
									@if (!string.IsNullOrWhiteSpace(details.AttributesJson))
									{
										<pre class="review-attributes-json">@details.AttributesJson</pre>
									}
								}
							</div>
						}

						<div class="review-photo-actions">
							<button class="review-btn" type="button" disabled="@isBusy" @onclick="() => ReanalyzeAsync(photo)">
								@(IsReanalyzing(photo) ? "Analysiere..." : "Neu analysieren")
							</button>
							<button class="review-btn review-btn-danger" type="button" disabled="@isBusy" @onclick="() => RequestDeletePhoto(photo)">Löschen</button>
						</div>

						@if (reanalysisErrors.TryGetValue(photo.PhotoId, out var reanalysisError))
						{
							<p class="review-reanalysis-error" role="alert">@reanalysisError</p>
						}
					</div>
				</article>
			}
		</div>
	}
</div>

@if (photoPendingDeletion is not null)
{
	var pendingPhoto = photoPendingDeletion;

	<div class="review-delete-dialog-backdrop" @onclick="CancelDeletePhoto">
		<div class="review-delete-dialog" @onclick:stopPropagation="true">
			<h2>Foto löschen?</h2>
			<p>Das Foto <strong>@pendingPhoto.SourceFileName</strong> und die zugehörige Sidecar-Datei werden unwiderruflich gelöscht.</p>
			<div class="review-delete-dialog-actions">
				<button class="review-btn" type="button" disabled="@IsBusy(pendingPhoto)" @onclick="CancelDeletePhoto">Abbrechen</button>
				<button class="review-btn review-btn-danger" type="button" disabled="@IsBusy(pendingPhoto)" @onclick="ConfirmDeletePhotoAsync">
					@(IsBusy(pendingPhoto) ? "Löschen..." : "Endgültig löschen")
				</button>
			</div>
		</div>
	</div>
}

@code {
	private const string AllFilterValue = ReviewSession.AllFilterValue;
	internal const int MaxDisplayedPhotosPerGroup = 18;

	private static readonly Dictionary<string, (string ImageFile, string Caption)> SeriesLogos = new(StringComparer.Ordinal)
	{
		["Serie 1"] = (string.Empty, "[kein Symbol]"),
		["Serie 2"] = ("Series2_klein.jpg", "Silhouette einer Schlange"),
		["Serie 3"] = ("Series3_klein.jpg", "Silhouette einer Oni-Maske (Maske der Täuschung)"),
		["Serie 4"] = ("Series4_klein.jpg", "Auge eines Drachen"),
		["Serie 5"] = ("Series5_klein.jpg", "Prime Empire (schwarz)"),
		["Serie 5 Next Level"] = ("Series5NL_klein.jpg", "Prime Empire - Next Level (gelb oder rot)"),
		["Serie 6"] = ("Series6_klein.jpg", "Rot (The Island)"),
		["Serie 6 Next Level"] = ("Series6NL_klein.jpg", "Affenschädel (gelb)"),
		["Serie 7"] = ("Series7_klein.jpg", "Seabound Logo"),
		["Serie 7 Next Level"] = ("Series7NL_klein.jpg", "Seabound Logo - Next Level"),
		["Serie 8"] = ("Series8_klein.jpg", "Crystalized Logo"),
		["Serie 8 Next Level"] = ("Series8NL_klein.jpg", "Crystalized Logo - Next Level"),
		["Serie 9"] = ("Series9_klein.jpg", "Drache (Quelldrache der Bewegung)"),
		["Serie 9 Next Level"] = ("Series9NL_klein.jpg", "Drachenkopf Dragons Rising (Next Level)"),
		["Serie 10"] = ("Series10_klein.jpg", "Wolfskopf"),
		["Serie 11"] = ("Series11_klein.jpg", "Dragon Storm Logo")
	};

	private IReadOnlyList<string> knownSeries = Array.Empty<string>();
	// Loaded once (and again only via "Von vorne beginnen"); every photo change is applied to it
	// locally instead of re-fetching the collection.
	private ReviewSession session = new(new ReviewSnapshot([], []));
	private bool isLoading = true;
	private bool isConfirmingAll;
	private string? busyPhotoId;
	// Re-analysis takes seconds, so several can be in flight at once (one per tile) - unlike
	// busyPhotoId, which only tracks the single quick action currently running.
	private readonly HashSet<string> reanalyzingPhotoIds = new(StringComparer.Ordinal);
	private readonly Dictionary<string, string> reanalysisErrors = new(StringComparer.Ordinal);
	private CardListItem? photoPendingDeletion;
	private readonly HashSet<string> expandedPhotos = new(StringComparer.Ordinal);
	// Unsaved card-number edits, by photo. A photo without an entry shows its own CardNumber, so
	// dropping the entry (after a save, a re-analysis or a delete) is how a tile is re-synced.
	private readonly Dictionary<string, string> cardNumberDrafts = new(StringComparer.Ordinal);
	private readonly Dictionary<string, CardDetailsItem> photoDetails = new(StringComparer.Ordinal);

	// Set by links from the Gallery: open on this card's group instead of the default first one.
	[SupplyParameterFromQuery(Name = "series")]
	public string? SeriesQueryParameter { get; set; }

	[SupplyParameterFromQuery(Name = "card")]
	public string? CardQueryParameter { get; set; }

	private IReadOnlyList<CardReviewGroup> FilteredGroups => session.FilteredGroups;

	private CardReviewGroup? CurrentGroup => session.CurrentGroup;

	protected override async Task OnInitializedAsync()
	{
		knownSeries = await CatalogServiceClient.GetKnownSeriesAsync();
		session = new ReviewSession(await CollectionQueryService.GetReviewSnapshotAsync());
		session.TryShowCard(SeriesQueryParameter, CardQueryParameter);
		await EnsureCurrentGroupUrlsAsync();
		isLoading = false;
	}

	/// <summary>
	/// Resolves download URLs for the shown group's photos that lack one (one bounded call, only for
	/// those photos - see <see cref="ReviewSession.ResolveMissingDownloadUrlsAsync"/>). Called after
	/// anything that can change which group is shown or which photos it holds.
	/// </summary>
	private Task EnsureCurrentGroupUrlsAsync()
	{
		return session.ResolveMissingDownloadUrlsAsync(
			MaxDisplayedPhotosPerGroup,
			photoIds => PictureServiceClient.GetDownloadUrlsAsync(photoIds));
	}

	private async Task GoToPreviousAsync()
	{
		session.GoToPrevious();
		await EnsureCurrentGroupUrlsAsync();
	}

	private async Task GoToNextAsync()
	{
		session.GoToNext();
		await EnsureCurrentGroupUrlsAsync();
	}

	private string GetCardNumberDraft(CardListItem photo)
	{
		return cardNumberDrafts.TryGetValue(photo.PhotoId, out var draft) ? draft : photo.CardNumber ?? string.Empty;
	}

	internal static IReadOnlyList<CardListItem> DisplayedPhotos(CardReviewGroup group)
	{
		return group.Photos.Count <= MaxDisplayedPhotosPerGroup
			? group.Photos
			: group.Photos.Take(MaxDisplayedPhotosPerGroup).ToArray();
	}

	internal static bool HasHiddenPhotos(CardReviewGroup group)
	{
		return group.Photos.Count > MaxDisplayedPhotosPerGroup;
	}

	internal static string GroupTitle(CardReviewGroup group)
	{
		if (group.IsCatchAll)
		{
			return "Ohne bekannte Serie";
		}

		return string.IsNullOrWhiteSpace(group.CardName)
			? $"{group.SeriesName} · Nr. {group.CardNumber}"
			: $"{group.SeriesName} · Nr. {group.CardNumber} · {group.CardName}";
	}

	private bool IsBusy(CardListItem photo)
	{
		return isConfirmingAll
			|| string.Equals(busyPhotoId, photo.PhotoId, StringComparison.Ordinal)
			|| IsReanalyzing(photo);
	}

	private bool IsReanalyzing(CardListItem photo)
	{
		return reanalyzingPhotoIds.Contains(photo.PhotoId);
	}

	private bool IsExpanded(CardListItem photo)
	{
		return expandedPhotos.Contains(photo.PhotoId);
	}

	private CardDetailsItem? GetDetails(CardListItem photo)
	{
		return photoDetails.TryGetValue(photo.PhotoId, out var details) ? details : null;
	}

	private async Task ToggleDetails(CardListItem photo)
	{
		if (!expandedPhotos.Add(photo.PhotoId))
		{
			expandedPhotos.Remove(photo.PhotoId);
			return;
		}

		if (!photoDetails.ContainsKey(photo.PhotoId))
		{
			photoDetails[photo.PhotoId] = await PictureServiceClient.GetCardDetailsAsync(photo.PhotoId);
		}
	}

	/// <summary>
	/// The one path back to the server after the initial load: re-fetches the collection (picking up
	/// changes made elsewhere), keeps the active filters, and returns to the first matching group.
	/// </summary>
	private async Task RestartFromBeginningAsync()
	{
		session.Reload(await CollectionQueryService.GetReviewSnapshotAsync());
		cardNumberDrafts.Clear();
		photoDetails.Clear();
		await EnsureCurrentGroupUrlsAsync();
	}

	private async Task OnReviewStatusFilterChanged(ChangeEventArgs e)
	{
		session.SetReviewStatusFilter(e.Value?.ToString() ?? AllFilterValue);
		await EnsureCurrentGroupUrlsAsync();
	}

	private async Task OnAnalysisStatusFilterChanged(ChangeEventArgs e)
	{
		session.SetAnalysisStatusFilter(e.Value?.ToString() ?? AllFilterValue);
		await EnsureCurrentGroupUrlsAsync();
	}

	private async Task OnSearchTextChanged(ChangeEventArgs e)
	{
		session.SetSearchText(e.Value?.ToString() ?? string.Empty);
		await EnsureCurrentGroupUrlsAsync();
	}

	private async Task SetReviewStatusAsync(CardListItem photo, string reviewStatus)
	{
		var xpBefore = await TryGetXpBeforeAsync();
		await RunPhotoActionAsync(
			photo,
			() => PictureServiceClient.UpdateReviewStatusAsync(photo.PhotoId, reviewStatus),
			() => session.ReplacePhoto(photo.PhotoId, current => ReviewSession.WithReviewStatus(current, reviewStatus)));
		await CelebrateSilentlyIfAnythingUnlockedAsync(xpBefore);
	}

	private async Task SaveCardNumberAsync(CardListItem photo)
	{
		var cardNumber = GetCardNumberDraft(photo);
		var xpBefore = await TryGetXpBeforeAsync();
		CardListItem? after = null;
		await RunPhotoActionAsync(
			photo,
			() => PictureServiceClient.UpdateCardNumberAsync(photo.PhotoId, cardNumber),
			() =>
			{
				session.ReplacePhoto(photo.PhotoId, current =>
				{
					after = ReviewSession.WithCardNumber(current, cardNumber);
					return after;
				});
				cardNumberDrafts.Remove(photo.PhotoId);
			});

		if (after is not null)
		{
			await TryCelebrateCardChangeAsync(photo, after, xpBefore);
		}
	}

	private async Task SaveLanguageAsync(CardListItem photo, string? language)
	{
		await RunPhotoActionAsync(
			photo,
			() => PictureServiceClient.UpdateCardLanguageAsync(photo.PhotoId, language),
			() => session.ReplacePhoto(photo.PhotoId, current => ReviewSession.WithLanguage(current, language)));
	}

	private static string GetSegmentClass(CardListItem photo, string reviewStatus)
	{
		if (!string.Equals(photo.ReviewStatus, reviewStatus, StringComparison.OrdinalIgnoreCase))
		{
			return "review-status-segment";
		}

		return $"review-status-segment review-status-segment-active {GetReviewStatusClass(reviewStatus)}";
	}

	private static string GetReviewStatusClass(string reviewStatus) => reviewStatus.ToLowerInvariant() switch
	{
		ReviewStatuses.Verified => "status-ok",
		ReviewStatuses.Incorrect => "status-failed",
		_ => "status-pending"
	};

	private static string GetReviewStatusLabel(string reviewStatus) => reviewStatus.ToLowerInvariant() switch
	{
		ReviewStatuses.Verified => "Bestätigt",
		ReviewStatuses.Incorrect => "Fehlerhaft",
		_ => "Nicht geprüft"
	};

	private static string GetAnalysisStatusLabel(string analysisStatus) => analysisStatus.ToLowerInvariant() switch
	{
		AnalysisStatuses.Ok => "Erkannt",
		AnalysisStatuses.Uncertain => "Unsicher",
		AnalysisStatuses.NotAnalyzed => "Nicht analysiert",
		_ => "Fehler"
	};

	/// <summary>
	/// Saves one photo change and, only once the save has succeeded, applies it to the in-memory
	/// session (which regroups and keeps the current position where possible). A failed save throws
	/// before <paramref name="applyLocally"/> runs, so the tile keeps showing what is stored.
	/// </summary>
	private async Task RunPhotoActionAsync(CardListItem photo, Func<Task> save, Action applyLocally)
	{
		busyPhotoId = photo.PhotoId;

		try
		{
			await save();
			applyLocally();
		}
		finally
		{
			busyPhotoId = null;
		}

		// The local edit may have moved a photo into (or the whole view onto) a group whose photos
		// have no URL yet.
		await EnsureCurrentGroupUrlsAsync();
	}

	private async Task ReanalyzeAsync(CardListItem photo)
	{
		if (!reanalyzingPhotoIds.Add(photo.PhotoId))
		{
			return;
		}

		reanalysisErrors.Remove(photo.PhotoId);
		var xpBefore = await TryGetXpBeforeAsync();

		try
		{
			CardListItem reanalyzed;
			try
			{
				reanalyzed = await PictureServiceClient.ReanalyzePhotoAsync(photo.PhotoId);
			}
			catch (Exception exception) when (exception is not OperationCanceledException)
			{
				reanalysisErrors[photo.PhotoId] = GetReanalysisErrorMessage(exception);
				return;
			}

			// Details are cached per photo on first expand; drop the now-stale entry and, if the
			// tile is open, fetch the new one right away.
			photoDetails.Remove(photo.PhotoId);
			if (IsExpanded(photo))
			{
				photoDetails[photo.PhotoId] = await PictureServiceClient.GetCardDetailsAsync(photo.PhotoId);
			}

			// The reanalysis response carries no image URL; keep the one the tile already shows
			// (which also spares the browser re-downloading the photo).
			var updated = reanalyzed with { ImageUrl = photo.ImageUrl };
			session.ReplacePhoto(photo.PhotoId, _ => updated);
			cardNumberDrafts.Remove(photo.PhotoId);
			await EnsureCurrentGroupUrlsAsync();

			await TryCelebrateCardChangeAsync(photo, updated, xpBefore);
		}
		finally
		{
			reanalyzingPhotoIds.Remove(photo.PhotoId);
		}
	}

	internal static string GetReanalysisErrorMessage(Exception exception)
	{
		return exception is RpcException { StatusCode: StatusCode.Unavailable or StatusCode.FailedPrecondition }
			? "Die Neu-Analyse ist gerade nicht möglich (Dienst nicht erreichbar oder nicht konfiguriert). Bitte später erneut versuchen."
			: "Die Neu-Analyse ist fehlgeschlagen.";
	}

	private void RequestDeletePhoto(CardListItem photo)
	{
		photoPendingDeletion = photo;
	}

	private void CancelDeletePhoto()
	{
		photoPendingDeletion = null;
	}

	private async Task ConfirmDeletePhotoAsync()
	{
		var photo = photoPendingDeletion;
		if (photo is null)
		{
			return;
		}

		await RunPhotoActionAsync(
			photo,
			() => PictureServiceClient.DeletePhotoAsync(photo.PhotoId),
			() =>
			{
				session.RemovePhoto(photo.PhotoId);
				cardNumberDrafts.Remove(photo.PhotoId);
				photoDetails.Remove(photo.PhotoId);
				expandedPhotos.Remove(photo.PhotoId);
			});
		photoPendingDeletion = null;
	}

	private async Task PickSeriesAsync(CardListItem photo, string seriesName)
	{
		await ReassignSeriesAsync(photo, seriesName);
	}

	private async Task ReassignSeriesAsync(CardListItem photo, string seriesName)
	{
		var xpBefore = await TryGetXpBeforeAsync();
		CardListItem? after = null;
		await RunPhotoActionAsync(
			photo,
			() => PictureServiceClient.UpdateSetNameAsync(photo.PhotoId, seriesName),
			() => session.ReplacePhoto(photo.PhotoId, current =>
			{
				after = ReviewSession.WithSetName(current, seriesName);
				return after;
			}));

		if (after is not null)
		{
			await TryCelebrateCardChangeAsync(photo, after, xpBefore);
		}
	}

	private async Task ConfirmAllAsync()
	{
		var group = CurrentGroup;
		if (group is null)
		{
			return;
		}

		isConfirmingAll = true;
		var xpBefore = await TryGetXpBeforeAsync();

		try
		{
			await session.ConfirmAsync(
				DisplayedPhotos(group),
				photoId => PictureServiceClient.UpdateReviewStatusAsync(photoId, ReviewStatuses.Verified));
		}
		finally
		{
			isConfirmingAll = false;
		}

		// Confirming advances to the next group, whose photos have no URLs yet.
		await EnsureCurrentGroupUrlsAsync();

		// Routine "Confirm All" on an already-correct match only changes Review Status, never
		// Owned Copies (they're independent - see the glossary), so it never shows the card
		// overlay - only a standalone toast if something (e.g. review-50) unlocked from it.
		await CelebrateSilentlyIfAnythingUnlockedAsync(xpBefore);
	}

	private async Task<int?> TryGetXpBeforeAsync()
	{
		try
		{
			return await GamificationService.GetXpAsync(session.Snapshot);
		}
		catch (Exception)
		{
			return null;
		}
	}

	/// <summary>
	/// Raises the unlock-moment overlay only when a correction actually changed which catalog card
	/// the photo matches (web-card-review-flow) - a series/card-number edit that resolves to the
	/// same card, or clears the match entirely, is not a celebration-worthy event. Best-effort: the
	/// review action itself already succeeded by the time this runs, so a gamification hiccup here
	/// (e.g. CatalogService briefly unreachable) is swallowed rather than surfaced as a page error.
	/// </summary>
	private async Task TryCelebrateCardChangeAsync(CardListItem before, CardListItem after, int? xpBefore)
	{
		if (xpBefore is null)
		{
			return;
		}

		try
		{
			var oldKey = CollectionQueryService.BuildOwnershipKey(before.SetName, before.CardNumber);
			var newKey = CollectionQueryService.BuildOwnershipKey(after.SetName, after.CardNumber);

			if (string.IsNullOrWhiteSpace(newKey) || string.Equals(newKey, oldKey, StringComparison.Ordinal))
			{
				// The matched card didn't change (e.g. a re-analysis only updated Rarity), so this
				// isn't an Owned Copies change and gets no overlay - but it can still have crossed an
				// achievement (e.g. first-legendary), which still deserves its toast.
				await CelebrateSilentlyIfAnythingUnlockedAsync(xpBefore);
				return;
			}

			// Owned Copies from the session's in-memory photos - no need to re-fetch the collection.
			var snapshot = session.Snapshot;
			var matchedCard = snapshot.Catalog.FirstOrDefault(card =>
				string.Equals(CollectionQueryService.BuildOwnershipKey(card.Series, card.CardNumber), newKey, StringComparison.Ordinal));
			var ownedCopies = snapshot.Photos.Count(photo =>
				string.Equals(CollectionQueryService.BuildOwnershipKey(photo.SetName, photo.CardNumber), newKey, StringComparison.Ordinal));

			if (string.IsNullOrEmpty(matchedCard.Series) || ownedCopies <= 0)
			{
				return;
			}

			if (ownedCopies > 1)
			{
				// Correcting to an already-owned card is routine review clean-up, not a reveal - no
				// overlay, and duplicates earn no XP, so only an achievement it crossed gets a toast.
				await CelebrateSilentlyIfAnythingUnlockedAsync(xpBefore);
				return;
			}

			var evaluation = await GamificationService.EvaluateAsync(xpBefore.Value, snapshot);
			CelebrationCenter.CelebrateCard(UnlockCelebrationKind.NewCard,matchedCard.CardName, matchedCard.Series, matchedCard.CardNumber, after.Rarity, ownedCopies, evaluation);
		}
		catch (Exception)
		{
		}
	}

	private async Task CelebrateSilentlyIfAnythingUnlockedAsync(int? xpBefore)
	{
		if (xpBefore is null)
		{
			return;
		}

		try
		{
			var evaluation = await GamificationService.EvaluateAsync(xpBefore.Value, session.Snapshot);
			if (evaluation.NewlyUnlockedAchievements.Count > 0 || evaluation.RankedUp)
			{
				CelebrationCenter.CelebrateSilently(evaluation);
			}
		}
		catch (Exception)
		{
		}
	}
}
