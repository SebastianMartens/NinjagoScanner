@page
@model NinjagoScanner.Web.Pages.Account.AccessDeniedModel
@{
    ViewData["Title"] = "Zugriff verweigert";
}

<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Zugriff verweigert - Ninjago Scanner</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, sans-serif;
            background: #0d1117;
            color: #e6edf3;
            line-height: 1.5;
        }
        .auth-container { max-width: 400px; margin: 80px auto; padding: 0 1rem; }
        .auth-brand { text-align: center; margin-bottom: 2rem; }
        .auth-brand-text { font-family: 'Rajdhani', sans-serif; font-weight: 700; font-size: 1.5rem; color: #58a6ff; letter-spacing: 0.05em; }
        .auth-card { background: #161b22; border: 1px solid #30363d; border-radius: 12px; padding: 2rem; }
        .auth-title { font-family: 'Rajdhani', sans-serif; font-weight: 600; font-size: 1.25rem; margin-bottom: 1rem; text-align: center; }
        .auth-message { font-size: 0.9rem; color: #8b949e; text-align: center; margin-bottom: 1.5rem; }
        .btn-auth {
            display: block; width: 100%;
            background: #58a6ff; color: #fff; border: none; border-radius: 6px;
            padding: 0.625rem; font-family: 'Rajdhani', sans-serif;
            font-weight: 600; font-size: 1rem; letter-spacing: 0.02em; cursor: pointer;
            text-align: center; text-decoration: none;
            transition: background 0.15s;
        }
        .btn-auth:hover { background: #4c94e6; }
    </style>
</head>
<body>
    <div class="auth-container">
        <div class="auth-brand">
            <span class="auth-brand-text">NINJAGO SCANNER</span>
        </div>
        <div class="auth-card">
            <h1 class="auth-title">Zugriff verweigert</h1>
            <p class="auth-message">Dein Konto hat keinen Zugriff auf eine Sammlung. Bitte melde dich mit einem anderen Konto an oder wende dich an einen Administrator.</p>
            <a class="btn-auth" href="/Account/Login">Zur Anmeldung</a>
        </div>
    </div>
</body>
</html>
