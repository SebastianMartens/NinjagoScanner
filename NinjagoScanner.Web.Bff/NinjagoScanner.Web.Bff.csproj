<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- infra/modules/bff-lambda's provided.al2023 custom runtime always execs ./bootstrap at the
         zip root regardless of the function's configured handler - see that module's header
         comment. dotnet lambda package (deploy-web-bff.yml) does not rename the published
         executable on its own, so the assembly must be named "bootstrap" for the self-contained
         publish to produce the file Lambda actually looks for. -->
    <AssemblyName>bootstrap</AssemblyName>
    <!-- provided.al2023 is an OS-only minimal image with no libicu (see
         https://docs.aws.amazon.com/linux/al2023/ug/lambda.html). A self-contained .NET app
         crashes the whole process (Runtime.ExitError) the moment it touches globalization APIs
         unless it opts into invariant mode. Safe here: this project only ever does culture-neutral
         parsing/formatting (CultureInfo.InvariantCulture, ToUpperInvariant, plain-digit ToString()). -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Protobuf Include="Protos\catalog.proto" GrpcServices="Client" />
    <Protobuf Include="Protos\picture_service.proto" GrpcServices="Client" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.32.1" />
    <PackageReference Include="Grpc.Net.Client" Version="2.76.0" />
    <PackageReference Include="Grpc.Tools" Version="2.76.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="AWSSDK.S3" Version="4.0.102.2" />
    <PackageReference Include="AWSSDK.Extensions.NETCore.Setup" Version="4.0.100.9" />
    <PackageReference Include="Amazon.Lambda.AspNetCoreServer.Hosting" Version="1.7.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NinjagoScanner.Web.Shared\NinjagoScanner.Web.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NinjagoScanner.Web.Bff.Tests" />
  </ItemGroup>

</Project>
