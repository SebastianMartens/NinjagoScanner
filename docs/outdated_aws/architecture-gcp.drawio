        <mxCell id="e5" value="gRPC / HTTP2 + ID token&#10;private Cloud Run URL, IAM-authenticated" style="html=1;fontSize=11;endArrow=block;strokeColor=#4285F4;" edge="1" parent="1" source="n_picture" target="n_catalog">
          <mxGeometry relative="1" as="geometry" />
