          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e7" value="HTTPS :443&#10;service account ADC, no static keys" style="html=1;fontSize=11;endArrow=block;strokeColor=#F9AB00;" edge="1" parent="1" source="n_picture" target="n_firestore">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e8" value="iam.serviceAccounts.signBlob&#10;(presign only, no key file, no network byte transfer)" style="html=1;fontSize=11;endArrow=block;strokeColor=#34A853;dashed=1;" edge="1" parent="1" source="n_web" target="n_gcs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e9" value="HTTPS :443&#10;AI analysis calls" style="html=1;fontSize=11;endArrow=block;strokeColor=#666666;dashed=1;" edge="1" parent="1" source="n_picture" target="n_gemini">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e10" value="mounted as env var at boot" style="html=1;fontSize=10;endArrow=block;strokeColor=#EA4335;dashed=1;" edge="1" parent="1" source="n_secretmanager" target="n_picture">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e11" value="gcloud run deploy&#10;(3 services, path-filtered, push to main)" style="html=1;fontSize=11;endArrow=block;strokeColor=#666666;" edge="1" parent="1" source="n_github" target="box_run">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===================== Notes ===================== -->

        <mxCell id="n_note" value="Removed vs. Fly.io + AWS storage hybrid: the AWS account entirely — no IAM user, no static access key/secret, no cross-cloud egress, no second vendor bill/dashboard.&#10;Changed: S3 → Cloud Storage (signed URLs, same presigned-upload shape); DynamoDB + 3 GSIs → Firestore Native mode + 3 composite indexes (same 3 query patterns: by review status, by analysis status, by series+card-number); Fly Secrets (AWS keys) → nothing — each Cloud Run service's built-in service account gets IAM-scoped access to GCS/Firestore natively (Application Default Credentials, short-lived, auto-rotated); Fly 6PN private network → Cloud Run private ingress (internal) + IAM-authenticated service-to-service ID tokens; Secrets Manager → Secret Manager (same idea, GCP-native).&#10;Real cost of this option, independent of $: this is a second rewrite of PhotoStore.cs/SidecarTable.cs against GCP SDKs, a second one-time data copy (S3/DynamoDB → GCS/Firestore), and redesigning the DynamoDB GSIs as Firestore composite indexes — on top of the S3/DynamoDB migration finished 2 days ago.&#10;Kept: gRPC contracts between the 3 services; presigned/signed-URL direct-to-storage upload flow; CatalogService/PictureService application logic unchanged." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8DC;strokeColor=#B8860B;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="260" y="700" width="960" height="160" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
